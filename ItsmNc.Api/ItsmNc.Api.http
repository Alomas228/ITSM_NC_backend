@ItsmNc.Api_HostAddress = https://localhost:7178

# Проверяем запуск приложения через описание API.
GET {{ItsmNc.Api_HostAddress}}/openapi/v1.json
Accept: application/json

###

# Без JWT ожидается 401. Проверка валидного токена описана в README.
GET {{ItsmNc.Api_HostAddress}}/api/auth/me
Accept: application/json

###
